#!/bin/sh
# Developer entry point for building this tree for Windows from a non-Windows
# host: mingw-w64 produces the PE binaries, Wine runs them.
#
#   tools/x image                  build the container image
#   tools/x shell                  interactive shell inside the container
#   tools/x configure [ARCH] ...   run cmake configure  (ARCH: i686 | x86_64 | aarch64)
#   tools/x arm-prep               generate src/core/gen/ for aarch64 (uses x86_64)
#   tools/x build     [ARCH] ...   build (extra args go to cmake --build)
#   tools/x bytecompile [ARCH]     byte compile the lisp library (makes start up fast)
#   tools/x package   [ARCH]       install into _dist/ARCH (a runnable tree to copy out)
#   tools/x test      [ARCH] ...   run the lisp test suite under Wine
#   tools/x wine      [ARCH] ...   run xyzzy-batch.exe with the test environment set
#   tools/x screenshot [FILE]      capture the virtual display (default _build/screenshot.png)
#   tools/x run       [ARCH] ...   run an arbitrary command in the container
#
# ARCH defaults to $XYZZY_ARCH or x86_64.
#
# The MSVC build stays as it is; this is a second toolchain over the same
# CMakeLists, so a failure here is reproducible on any Linux or macOS box.
set -eu

IMAGE=xyzzy-devenv
ROOT=$(cd "$(dirname "$0")/.." && pwd)
ARCH_DEFAULT=${XYZZY_ARCH:-x86_64}

# A `git worktree add` sibling (e.g. to build a second commit for comparison
# without disturbing $ROOT) is otherwise invisible in here: only $ROOT is
# bind-mounted.  Mount every OTHER worktree registered against this checkout
# individually, each at /siblings/<its own basename> -- never their common
# parent: repos cloned with ghq sit flat as siblings of each other under one
# directory (.../github.com/<user>/<repo> for every repo, not just this one),
# so the common ancestor of two worktrees is typically that whole namespace,
# not something scoped to this project.  $ROOT itself keeps mounting at /work
# exactly as before: it is baked into every existing _build/$ARCH/CMakeCache.txt,
# so moving it would invalidate every build tree that is not part of what this
# is trying to fix.  A worktree already inside $ROOT (e.g. under .claude/worktrees/)
# is skipped: /work already covers it.
#
# Set XYZZY_SIBLINGS_DIR to a single directory to mount there instead (as
# /siblings, not per-worktree); XYZZY_SIBLINGS_DIR= (empty) disables this.
siblings_mounts() {
  worktrees=$(git -C "$ROOT" worktree list --porcelain 2>/dev/null | \
              awk '/^worktree /{print $2}')
  [ -n "$worktrees" ] || return 0

  old_ifs=$IFS
  IFS='
'
  # shellcheck disable=SC2086
  set -- $worktrees
  IFS=$old_ifs

  for wt in "$@"; do
    [ "$wt" = "$ROOT" ] && continue
    case "$wt" in "$ROOT"/*) continue ;; esac
    printf ' -v %s:/siblings/%s' "$wt" "$(basename "$wt")"
  done
}

docker_run() {
  tty_flag=""
  [ -t 0 ] && tty_flag="-it"

  if [ -z "${XYZZY_SIBLINGS_DIR+set}" ]; then
    siblings_flag=$(siblings_mounts)
  elif [ -n "$XYZZY_SIBLINGS_DIR" ]; then
    siblings_flag=" -v $XYZZY_SIBLINGS_DIR:/siblings"
  else
    siblings_flag=""
  fi

  # shellcheck disable=SC2086
  exec docker run --rm $tty_flag $siblings_flag \
    --platform linux/amd64 \
    -v "$ROOT":/work \
    -v xyzzy-wine64:/wine \
    -v xyzzy-wine32:/wine32 \
    -e XYZZY_ARCH \
    -e XYZZY_TEST_TIMEOUT \
    -e XYZZY_TEST_STALL \
    -e XYZZY_TEST_EXCLUDE \
    -e XYZZY_TEST_EXCLUDE_EXTRA \
    -e XYZZY_TEST_KNOWN_FAILURES \
    -e XYZZY_TEST_UPDATE_KNOWN_FAILURES \
    -w /work \
    "$IMAGE" "$@"
}

cmd=${1:-help}
[ $# -gt 0 ] && shift

# An optional first argument selects the target architecture.
case "${1:-}" in
  i686|x86_64|aarch64) ARCH=$1; shift ;;
  *) ARCH=$ARCH_DEFAULT ;;
esac

case "$cmd" in
  image)
    exec docker build --platform linux/amd64 -t "$IMAGE" "$ROOT/tools/devenv"
    ;;
  shell)
    docker_run bash
    ;;
  configure)
    docker_run cmake -S /work -B "/work/_build/$ARCH" -G Ninja \
      -DCMAKE_TOOLCHAIN_FILE="/work/cmake/mingw-$ARCH.cmake" \
      -DCMAKE_BUILD_TYPE=Release "$@"
    ;;
  build)
    docker_run cmake --build "/work/_build/$ARCH" "$@"
    ;;
  arm-prep)
    docker_run tools/arm-prep.sh
    ;;
  bytecompile)
    docker_run tools/bytecompile.sh "$ARCH" "$@"
    ;;
  package)
    docker_run tools/package.sh "$ARCH"
    ;;
  test)
    docker_run tools/run-tests.sh "$ARCH" "$@"
    ;;
  wine)
    docker_run tools/wine-run.sh "$ARCH" "$@"
    ;;
  screenshot)
    out=${1:-_build/screenshot.png}
    docker_run sh -c "import -window root '/work/$out' && ls -l '/work/$out'"
    ;;
  run)
    docker_run "$@"
    ;;
  *)
    sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
    ;;
esac
