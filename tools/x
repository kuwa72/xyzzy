#!/bin/sh
# Developer entry point for building this tree for Windows from a non-Windows
# host: mingw-w64 produces the PE binaries, Wine runs them.
#
#   tools/x image                  build the container image
#   tools/x shell                  interactive shell inside the container
#   tools/x configure [ARCH] ...   run cmake configure  (ARCH: i686 | x86_64 | aarch64 | linux)
#   tools/x arm-prep               generate src/core/gen/ for aarch64 (uses x86_64)
#   tools/x build     [ARCH] ...   build (extra args go to cmake --build)
#   tools/x bytecompile [ARCH]     byte compile the lisp library (makes start up fast)
#   tools/x package   [ARCH]       install into _dist/ARCH (a runnable tree to copy out)
#   tools/x test      [ARCH] ...   run the lisp test suite under Wine
#   tools/x smoke                  start the natively built POSIX binaries once (ARCH linux)
#   tools/x pty       [KEYS...]    drive the ncurses build on a pty and print the screen
#   tools/x wine      [ARCH] ...   run xyzzy-batch.exe with the test environment set
#   tools/x screenshot [FILE]      capture the virtual display (default _build/screenshot.png)
#   tools/x run       [ARCH] ...   run an arbitrary command in the container
#
# ARCH defaults to $XYZZY_ARCH or x86_64.
#
# ARCH "linux" is not a cross build: it builds the POSIX frontends
# (src/frontend/ncurses, src/frontend/cli) as native ELF binaries with the
# container's gcc, which is what .github/workflows/linux.yml does.  Wine, the
# byte compiler and the lisp suite are not part of it; "tools/x smoke" is the
# runtime check it has.
#
# The MSVC build stays as it is; this is a second toolchain over the same
# CMakeLists, so a failure here is reproducible on any Linux or macOS box.
set -eu

IMAGE=xyzzy-devenv
ROOT=$(cd "$(dirname "$0")/.." && pwd)
ARCH_DEFAULT=${XYZZY_ARCH:-x86_64}

# **メモリの上限を必ず付ける。** 上限が無いと、コンテナの中で暴走したものが
# ホストのメモリを取り切る。WSL では VM ごと膨らむので、**ホストが道連れに
# なる。** 実際に起きている: lisp テストスイートが make-array の上限の穴で
# 12.65 GiB まで伸びてホストの上限に迫った (issue #49、PR #91 で修正)。
# 上限があれば、暴走してもコンテナが OOM で殺されるだけで済む。
#
# 8g はビルド (ninja + clang を並列) には十分で、上の暴走は止まる大きさ。
# --memory-swap を同じ値にするのは、既定 (memory の 2 倍) だとスワップまで
# 使って WSL の VM が伸びるため。
#
# XYZZY_DOCKER_MEMORY= (空) で外せる。CPU は既定では絞らない: 張り付いても
# 待てば戻るのに対して、絞るとビルドが目に見えて遅くなる。必要なら
# XYZZY_DOCKER_CPUS=2 のように渡す。
: "${XYZZY_DOCKER_MEMORY=8g}"
: "${XYZZY_DOCKER_CPUS=}"

# A `git worktree add` sibling (e.g. to build a second commit for comparison
# without disturbing $ROOT) is otherwise invisible in here: only $ROOT is
# bind-mounted.  Mount every OTHER worktree registered against this checkout
# individually, each at /siblings/<its own basename> -- never their common
# parent: repos cloned with ghq sit flat as siblings of each other under one
# directory (.../github.com/<user>/<repo> for every repo, not just this one),
# so the common ancestor of two worktrees is typically that whole namespace,
# not something scoped to this project.  $ROOT itself keeps mounting at /work
# exactly as before: it is baked into every existing _build/$ARCH/CMakeCache.txt,
# so moving it would invalidate every build tree that is not part of what this
# is trying to fix.  A worktree already inside $ROOT (e.g. under .claude/worktrees/)
# is skipped: /work already covers it.
#
# Set XYZZY_SIBLINGS_DIR to a single directory to mount there instead (as
# /siblings, not per-worktree); XYZZY_SIBLINGS_DIR= (empty) disables this.
siblings_mounts() {
  worktrees=$(git -C "$ROOT" worktree list --porcelain 2>/dev/null | \
              awk '/^worktree /{print $2}')
  [ -n "$worktrees" ] || return 0

  old_ifs=$IFS
  IFS='
'
  # shellcheck disable=SC2086
  set -- $worktrees
  IFS=$old_ifs

  for wt in "$@"; do
    [ "$wt" = "$ROOT" ] && continue
    case "$wt" in "$ROOT"/*) continue ;; esac
    printf ' -v %s:/siblings/%s' "$wt" "$(basename "$wt")"
  done
}

docker_run() {
  tty_flag=""
  [ -t 0 ] && tty_flag="-it"

  limit_flag=""
  if [ -n "$XYZZY_DOCKER_MEMORY" ]; then
    limit_flag="--memory $XYZZY_DOCKER_MEMORY --memory-swap $XYZZY_DOCKER_MEMORY"
  fi
  if [ -n "$XYZZY_DOCKER_CPUS" ]; then
    limit_flag="$limit_flag --cpus $XYZZY_DOCKER_CPUS"
  fi

  if [ -z "${XYZZY_SIBLINGS_DIR+set}" ]; then
    siblings_flag=$(siblings_mounts)
  elif [ -n "$XYZZY_SIBLINGS_DIR" ]; then
    siblings_flag=" -v $XYZZY_SIBLINGS_DIR:/siblings"
  else
    siblings_flag=""
  fi

  # --init: tini を PID 1 に置く。これが無いと中のプロセスが PID 1 になり、
  # SIGTERM の既定動作が「無視」なので docker stop / Ctrl-C で止まらず、
  # 子プロセスも回収されない。
  #
  # shellcheck disable=SC2086
  $DOCKER_EXEC docker run --rm --init $tty_flag $limit_flag $siblings_flag \
    --platform linux/amd64 \
    -v "$ROOT":/work \
    -v xyzzy-wine64:/wine \
    -v xyzzy-wine32:/wine32 \
    -v xyzzy-ccache:/ccache \
    -e "CCACHE_DIR=/ccache/$ARCH" \
    -e XYZZY_ARCH \
    -e XYZZY_TEST_TIMEOUT \
    -e XYZZY_TEST_STALL \
    -e XYZZY_TEST_EXCLUDE \
    -e XYZZY_TEST_EXCLUDE_EXTRA \
    -e XYZZY_TEST_KNOWN_FAILURES \
    -e XYZZY_TEST_UPDATE_KNOWN_FAILURES \
    -e XYZZY_PTY_ROWS \
    -e XYZZY_PTY_COLS \
    -e XYZZY_PTY_BOOT \
    -e XYZZY_PTY_RAW \
    -w /work \
    "$IMAGE" "$@"
}

# docker_run は既定で exec する (コンテナが tools/x を置き換える)。戻って
# きてほしい呼び出しは `DOCKER_EXEC= docker_run ...' で呼ぶ。
DOCKER_EXEC=exec

cmd=${1:-help}
[ $# -gt 0 ] && shift

# An optional first argument selects the target architecture.
case "${1:-}" in
  i686|x86_64|aarch64|linux) ARCH=$1; shift ;;
  *) ARCH=$ARCH_DEFAULT ;;
esac

case "$cmd" in
  image)
    exec docker build --platform linux/amd64 -t "$IMAGE" "$ROOT/tools/devenv"
    ;;
  shell)
    docker_run bash
    ;;
  configure)
    # The native build takes no toolchain file: the compiler is the container's
    # own gcc and the product is ELF, not PE.
    if [ "$ARCH" = linux ]; then
      docker_run cmake -S /work -B /work/_build/linux -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_COMPILER_LAUNCHER=ccache \
        -DCMAKE_CXX_COMPILER_LAUNCHER=ccache "$@"
    else
      docker_run cmake -S /work -B "/work/_build/$ARCH" -G Ninja \
        -DCMAKE_TOOLCHAIN_FILE="/work/cmake/mingw-$ARCH.cmake" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_COMPILER_LAUNCHER=ccache \
        -DCMAKE_CXX_COMPILER_LAUNCHER=ccache "$@"
    fi
    ;;
  build)
    docker_run cmake --build "/work/_build/$ARCH" "$@"
    ;;
  arm-prep)
    docker_run tools/arm-prep.sh
    ;;
  bytecompile)
    docker_run tools/bytecompile.sh "$ARCH" "$@"
    ;;
  package)
    docker_run tools/package.sh "$ARCH"
    ;;
  test)
    # **先にビルドする。** run-tests.sh はビルドしないので、これが無いと
    # ソースを直したあとの `tools/x test' が**古い exe を測って通ってしまう。**
    # 実際に踏んだ: PRLOGFONT を core へ移した変更で Windows のビルドが
    # 壊れていたのに、`tools/x test x86_64' が前の exe で 1146 件 pass と
    # 報告し、CI で初めて分かった (issue #143 の作業中)。
    # ninja は最新なら何もしないので、付けても遅くならない。
    #
    # DOCKER_EXEC を空にして呼ぶと docker_run が exec しないで戻る
    # (既定は exec — コンテナを PID 1 の子として置き換える)。
    DOCKER_EXEC= docker_run cmake --build "/work/_build/$ARCH" || {
      echo "tools/x: ビルドが失敗した。テストは走らせない (古い exe を測ることになる)。" >&2
      exit 1
    }
    docker_run tools/run-tests.sh "$ARCH" "$@"
    ;;
  smoke)
    docker_run tools/linux-smoke.sh "$@"
    ;;
  pty)
    # Every argument is one step: keys to send, then the screen is printed.
    # See the docstring in tools/pty-drive.py for the escapes.
    docker_run python3 tools/pty-drive.py "$@"
    ;;
  wine)
    docker_run tools/wine-run.sh "$ARCH" "$@"
    ;;
  screenshot)
    out=${1:-_build/screenshot.png}
    docker_run sh -c "import -window root '/work/$out' && ls -l '/work/$out'"
    ;;
  run)
    docker_run "$@"
    ;;
  *)
    sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
    ;;
esac
