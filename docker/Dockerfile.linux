# ローカル確認用: Linux (ncurses フロントエンド) のビルド・テスト環境
#
#   docker/dev.sh linux all
#
# ホストの UID/GID でビルドするので、生成物 (build-docker/, grammars/*.so,
# lisp/*.lc) が root 所有にならない。
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        git \
        libncursesw5-dev \
        locales \
        ninja-build \
        pkg-config \
        zlib1g-dev \
    && sed -i -e 's/^# *\(ja_JP.UTF-8\)/\1/' -e 's/^# *\(en_US.UTF-8\)/\1/' /etc/locale.gen \
    && locale-gen \
    && rm -rf /var/lib/apt/lists/*

# マウントしたリポジトリの所有者がコンテナ内 UID と違っても git describe が動くように
RUN git config --system --add safe.directory '*'

ENV LANG=C.UTF-8 \
    TERM=xterm-256color

WORKDIR /work
